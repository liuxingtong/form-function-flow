{
  "version": "0.1.0",
  "description": "MVP editable block insertion constraints for CBD/OFC/TOD scenario planning.",
  "global": {
    "geometry_tolerance_m": 0.5,
    "min_block_area_sqm": 200,
    "max_aspect_ratio": 8.0,
    "no_overlap": true
  },
  "zones": {
    "CBD": {
      "use_share_by_gfa": {
        "office_business": { "min": 0.45, "max": 0.7 },
        "retail_commercial": { "min": 0.15, "max": 0.3 },
        "public_support": { "min": 0.1, "max": 0.2 },
        "residential": { "min": 0.0, "max": 0.2 }
      },
      "active_frontage_min_ratio": 0.6
    },
    "OFC": {
      "use_share_by_gfa": {
        "creative_office_rd": { "min": 0.35, "max": 0.6 },
        "green_open_recreation": { "min": 0.2, "max": 0.4 },
        "retail_support": { "min": 0.1, "max": 0.2 },
        "residential": { "min": 0.0, "max": 0.2 }
      },
      "open_space_ratio_min": 0.3
    },
    "TOD_GROUND": {
      "allowed_use_types": [
        "leisure_commercial_small",
        "transit_service",
        "station_support_amenity"
      ],
      "height_m_max": 12.0,
      "single_block_footprint_sqm_max": 1500
    },
    "TOD_DECK": {
      "use_share_by_gfa": {
        "residential": { "min": 0.5, "max": 0.75 },
        "public_support": { "min": 0.1, "max": 0.2 },
        "retail_local": { "min": 0.1, "max": 0.2 },
        "office": { "min": 0.0, "max": 0.15 }
      },
      "deck_structural_premium_factor": 1.2
    }
  },
  "validation_order": [
    "GEO_VALID",
    "GEO_INSIDE_ZONE",
    "GEO_NO_OVERLAP",
    "ZONE_ALLOWED_USE",
    "ZONE_HEIGHT_LIMIT",
    "ZONE_SHARE_LIMITS"
  ],
  "rule_ids": [
    "GEO_INSIDE_ZONE",
    "GEO_NO_OVERLAP",
    "CBD_MIN_OFFICE_SHARE",
    "OFC_MIN_OPENSPACE_RATIO",
    "TODG_MAX_HEIGHT_12M",
    "TODD_MIN_RES_SHARE",
    "TODD_MIN_PUBLIC_SUPPORT_SHARE"
  ]
}

